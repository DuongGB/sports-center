<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="add-reply-columns-to-reviews-v2" author="antigravity">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="reviews" columnName="admin_reply"/>
            </not>
        </preConditions>
        <addColumn tableName="reviews">
            <column name="admin_reply" type="TEXT"/>
            <column name="replied_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
