<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="007-create-booking-qr-codes-table" author="devduong">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="booking_qr_codes"/>
            </not>
        </preConditions>
        <createTable tableName="booking_qr_codes">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="qr_token" type="VARCHAR(255)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="qr_code_url" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="expired_at" type="TIMESTAMP"/>
            <column name="generated_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="checked_in_at" type="TIMESTAMP"/>
            <column name="checked_in_by" type="VARCHAR(255)"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="booking_qr_codes" baseColumnNames="booking_id"
                                 referencedTableName="bookings" referencedColumnNames="id"
                                 constraintName="fk_booking_qr_codes_booking"/>
                                 
        <addForeignKeyConstraint baseTableName="booking_qr_codes" baseColumnNames="checked_in_by"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_booking_qr_codes_user"/>

        <createIndex tableName="booking_qr_codes" indexName="idx_booking_qr_codes_booking_id">
            <column name="booking_id"/>
        </createIndex>
        <createIndex tableName="booking_qr_codes" indexName="idx_booking_qr_codes_qr_token">
            <column name="qr_token"/>
        </createIndex>
        <createIndex tableName="booking_qr_codes" indexName="idx_booking_qr_codes_status">
            <column name="status"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-create-booking-checkin-logs-table" author="devduong">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="booking_checkin_logs"/>
            </not>
        </preConditions>
        <createTable tableName="booking_checkin_logs">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_qr_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="scanned_by" type="VARCHAR(255)"/>
            <column name="scanned_at" type="TIMESTAMP" defaultValueComputed="now()">
                <constraints nullable="false"/>
            </column>
            <column name="device_info" type="VARCHAR(255)"/>
            <column name="ip_address" type="VARCHAR(255)"/>
            <column name="note" type="TEXT"/>
        </createTable>

        <addForeignKeyConstraint baseTableName="booking_checkin_logs" baseColumnNames="booking_qr_id"
                                 referencedTableName="booking_qr_codes" referencedColumnNames="id"
                                 constraintName="fk_booking_checkin_logs_qr"/>

        <addForeignKeyConstraint baseTableName="booking_checkin_logs" baseColumnNames="scanned_by"
                                 referencedTableName="users" referencedColumnNames="id"
                                 constraintName="fk_booking_checkin_logs_user"/>

        <createIndex tableName="booking_checkin_logs" indexName="idx_booking_checkin_logs_qr_id">
            <column name="booking_qr_id"/>
        </createIndex>
        <createIndex tableName="booking_checkin_logs" indexName="idx_booking_checkin_logs_scanned_by">
            <column name="scanned_by"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
